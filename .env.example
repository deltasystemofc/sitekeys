# Porta do servidor (o Railway preenche automaticamente a variável PORT)
PORT=3000

# Token da API Delta (Opcional - já vem pré-configurado com o seu padrão)
DELTA_API_TOKEN=DELTA-a480f9e6b7ace86ab59c5507b9e4cc3f

# Intervalo de monitoramento em segundos (padrão: 5s)
POLLING_INTERVAL_SEC=5

# Diretório de persistência de dados (opcional para volumes persistentes no Railway)
# DATA_DIR=/data
