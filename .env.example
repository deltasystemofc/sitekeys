# Configurações do Servidor
PORT=3000

# Credenciais de Acesso do Painel Administrativo
ADMIN_USER=seu_usuario_admin
ADMIN_PASS=sua_senha_forte

# Chave Secreta para Sessão Local
SESSION_SECRET=coloque_uma_chave_aleatoria_longa_aqui

# URL Base da API do Gerador
API_BASE_URL=https://nexusproxy.shop

# Token Secreto da API Nexus
DELTA_API_TOKEN=seu_token_api_aqui

# Intervalo de monitoramento em segundos
POLLING_INTERVAL_SEC=5

# Configuração PostgreSQL no Railway (DATABASE_URL ou variáveis individuais)
# DATABASE_URL=postgresql://postgres:senha@postgres.railway.internal:5432/railway
